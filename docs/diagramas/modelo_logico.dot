digraph logico {
  graph [rankdir=LR, splines=spline, nodesep=0.4, ranksep=1.1, fontname="Inter", pad=0.3, bgcolor="white"];
  node  [shape=plain, fontname="Inter", fontsize=10];
  edge  [color="#5b6472", penwidth=1.1, arrowsize=0.9, dir=both];
  agendamento [label=<<TABLE BORDER="1.2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d3557"><TR><TD BGCOLOR="#1d3557" COLSPAN="2"><FONT COLOR="white"><B>agendamento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_agendamento"><B>id_agendamento</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_animal"><I>id_animal</I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_veterinario"><I>id_veterinario</I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_hora_inicio">data_hora_inicio</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="data_hora_fim">data_hora_fim</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="tipo">tipo</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="motivo">motivo <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_cancelamento">motivo_cancelamento <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="criado_em">criado_em</TD><TD ALIGN="RIGHT"> </TD></TR></TABLE>>];
  animal [label=<<TABLE BORDER="1.2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d3557"><TR><TD BGCOLOR="#1d3557" COLSPAN="2"><FONT COLOR="white"><B>animal</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_animal"><B>id_animal</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_tutor"><I>id_tutor</I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_raca"><I>id_raca</I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="sexo">sexo</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="data_nascimento">data_nascimento <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="pelagem">pelagem <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="castrado">castrado</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="microchip">microchip <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_obito">data_obito <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="observacoes">observacoes <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="criado_em">criado_em</TD><TD ALIGN="RIGHT"> </TD></TR></TABLE>>];
