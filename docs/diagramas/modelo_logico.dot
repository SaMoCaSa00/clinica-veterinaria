  especie [label=<<TABLE BORDER="1.2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d3557"><TR><TD BGCOLOR="#1d3557" COLSPAN="2"><FONT COLOR="white"><B>especie</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_especie"><B>id_especie</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">UQ</FONT></TD></TR></TABLE>>];
  medicamento [label=<<TABLE BORDER="1.2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d3557"><TR><TD BGCOLOR="#1d3557" COLSPAN="2"><FONT COLOR="white"><B>medicamento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_medicamento"><B>id_medicamento</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome_comercial">nome_comercial</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="principio_ativo">principio_ativo</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="concentracao">concentracao</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="forma_farmaceutica">forma_farmaceutica</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="fabricante">fabricante <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="controlado">controlado</TD><TD ALIGN="RIGHT"> </TD></TR></TABLE>>];
  medicamento_especie [label=<<TABLE BORDER="1.2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d3557"><TR><TD BGCOLOR="#1d3557" COLSPAN="2"><FONT COLOR="white"><B>medicamento_especie</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_medicamento"><I><B>id_medicamento</B></I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_especie"><I><B>id_especie</B></I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK FK</FONT></TD></TR></TABLE>>];
  prescricao [label=<<TABLE BORDER="1.2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d3557"><TR><TD BGCOLOR="#1d3557" COLSPAN="2"><FONT COLOR="white"><B>prescricao</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_prescricao"><B>id_prescricao</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_atendimento"><I>id_atendimento</I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_medicamento"><I>id_medicamento</I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dose_quantidade">dose_quantidade</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="dose_unidade">dose_unidade</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="via_administracao">via_administracao</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="frequencia_horas">frequencia_horas</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="duracao_dias">duracao_dias <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="instrucoes">instrucoes <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR></TABLE>>];
  procedimento [label=<<TABLE BORDER="1.2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d3557"><TR><TD BGCOLOR="#1d3557" COLSPAN="2"><FONT COLOR="white"><B>procedimento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_procedimento"><B>id_procedimento</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria">categoria</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="descricao">descricao <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="preco_base">preco_base</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="ativo">ativo</TD><TD ALIGN="RIGHT"> </TD></TR></TABLE>>];
  procedimento_especie [label=<<TABLE BORDER="1.2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d3557"><TR><TD BGCOLOR="#1d3557" COLSPAN="2"><FONT COLOR="white"><B>procedimento_especie</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_procedimento"><I><B>id_procedimento</B></I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_especie"><I><B>id_especie</B></I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK FK</FONT></TD></TR></TABLE>>];
  raca [label=<<TABLE BORDER="1.2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1d3557"><TR><TD BGCOLOR="#1d3557" COLSPAN="2"><FONT COLOR="white"><B>raca</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_raca"><B>id_raca</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_especie"><I>id_especie</I></TD><TD ALIGN="RIGHT"><FONT COLOR="#c1121f" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="RIGHT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="porte">porte <FONT COLOR="#8d99ae">∅</FONT></TD><TD ALIGN="RIGHT"> </TD></TR></TABLE>>];
